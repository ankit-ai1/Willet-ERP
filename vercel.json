{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!assets/|config\\.js|favicon\\.svg).*)", "destination": "/index.html" }],
  "headers": [{ "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
}
